<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  DEPRECATED — do not use for Black Label Trading.

  This file previously enabled com.apple.security.app-sandbox. Trading ships OUTSIDE the App
  Store via Developer ID because it spawns its own bundled Python data backend, which the
  App Store sandbox would forbid (no Process() spawn of /bin/bash, no loopback server, no writes
  to ~/Library/Application Support outside the container). Shipping Trading sandboxed BREAKS the
  backend, so the sandbox was removed.

  Use instead:
    * Sources/app-developerid.entitlements  — the canonical Trading entitlements (no sandbox, no
      applesignin; network.client + the hardened-runtime exceptions the python backend needs).
      Both build.command and build-developer-id.sh sign against it.
    * Sources/app-release.entitlements      — ONLY for a provisioned build (build-signed.command)
      that legitimately carries the restricted "Sign in with Apple" entitlement.

  Kept as a non-sandboxed, harmless fallback so an accidental reference can never re-introduce
  the sandbox and break the backend.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
